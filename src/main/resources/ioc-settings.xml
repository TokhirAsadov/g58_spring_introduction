<!--        <constructor-arg name="age" value="40"/>-->

<!--        <property name="fullName" value="Ali Valiyev" />-->
<!--        <property name="age" value="18" />-->
<!--    </bean>-->

    <bean id="person" class="uz.pdp.Person"
          factory-method="getInstance"
          init-method="init"
          destroy-method="destroy"
        p:fullName="Eshmatov Toshmat"
        p:age="29"
    >
        <property name="nickNames">
            <list>
                <value>White Developer</value>
                <value>Black Code</value>
                <value>Hacker</value>
            </list>
        </property>
        <property name="jobs">
            <map>
                <entry key="1" value="Junior Java Developer" />
                <entry key="2" value="Strong Junior Java Developer" />
                <entry key="3" value="Middle Java Developer" />
            </map>
        </property>
    </bean>

    <bean id="baseDao" class="uz.pdp.BaseDAO"
        c:_0="${database.url}"
        c:_1="${database.db}"
        c:_2="${database.user}"
        c:_3="${database.password}"
        c:_4="${database.driver}"
    />
</beans>